{
  "descripcion": "Secciones de contenedores de Asistencias UCO y escenarios de prueba. Lo usa infra.ps1 stack (scripts/orchestration/stack.ps1). Rutas relativas a la raiz del workspace (la carpeta que contiene AsistenciasUCO-Infra).",
  "red": "asis-red",
  "redesExternas": [
    "asis-red",
    "asistencias-files-backend",
    "asistencias-security-lab-net"
  ],
  "volumenesExternos": [
    "asis-datos-mssql",
    "asistencias-minio-data",
    "ext-mensajes-pulsar-data",
    "catalogo-parametros_redis-data",
    "catalogo-parametros_surrealdb-data",
    "catalogo-parametros_pulsar-parametros-data",
    "catalogo-parametros_pulsar-parametros-conf",
    "asistencias_clamav_data",
    "asistencias-uco-security_keycloak_db_data",
    "asistencias-uco-observability_grafana_data",
    "asistencias-uco-observability_prometheus_data",
    "asistencias-uco-observability_loki_data",
    "asistencias-uco-observability_tempo_data",
    "messageucolab_redis_data",
    "messageucolab_surrealdb-data",
    "messageucolab_pulsar-conf",
    "messageucolab_grafana-data",
    "messageucolab_loki-data",
    "messageucolab_ollama-data",
    "catalogo-parametros_grafana-data",
    "catalogo-parametros_prometheus-data",
    "asistencias-security-lab_asistencias-security-lab-keycloak-data",
    "asistencias-security-lab_asistencias-security-lab-surrealdb-data",
    "asistencias-security-lab_asistencias-security-lab-redis-data"
  ],
  "limiteMemoriaMb": 9700,
  "secciones": {
    "asis-datos": {
      "descripcion": "SQL Server (BD del laboratorio) y MinIO (soportes). Siempre arriba.",
      "siempre": true,
      "memoriaMb": 2500,
      "directorio": "GestioAsistenciaBackend/infra/files",
      "compose": [
        "compose.yaml",
        "@stack/secciones/asis-datos.yml"
      ],
      "envFiles": [
        "@stack/.env",
        ".env"
      ],
      "servicios": [
        "sqlserver",
        "minio",
        "minio-init"
      ],
      "salud": [
        "contenedor:sql_server_asistencias",
        "contenedor:asis-datos-minio"
      ],
      "urls": [
        "SQL Server: localhost,1433 (sa)",
        "MinIO API: http://localhost:9000"
      ],
      "proyectosAnteriores": [
        "asistencias-files"
      ]
    },
    "ext-seguridad": {
      "descripcion": "Componente de Seguridad del equipo (Security Baseline 0.1.14: Keycloak, PDP, PEP, OPA y RabbitMQ de eventos).",
      "memoriaMb": 1600,
      "directorio": "GestioAsistenciaBackend/infra/security-baseline",
      "compose": [
        "compose.yaml",
        "@stack/secciones/ext-seguridad.yml"
      ],
      "envFiles": [
        "~/.asistencias-security-lab/lab.env"
      ],
      "servicios": [
        "keycloak",
        "keycloak-relay",
        "surrealdb",
        "redis",
        "opa",
        "pdp",
        "pep",
        "rabbitmq",
        "rabbitmq-init",
        "consola"
      ],
      "salud": [
        "contenedor:ext-seguridad-keycloak",
        "contenedor:ext-seguridad-pdp",
        "contenedor:ext-seguridad-rabbitmq",
        "http:http://localhost:18081/actuator/health",
        "contenedor:ext-seguridad-consola",
        "http:http://localhost:5175/security-administration.js"
      ],
      "urls": [
        "Keycloak: http://keycloak.localhost:19090",
        "PDP: http://localhost:18080",
        "PEP: http://localhost:18081",
        "RabbitMQ (eventos del PDP): amqp://localhost:25672, consola http://localhost:25673",
        "Consola de seguridad: http://localhost:5175 (dist de Complementos/Seguridad/security-ui)"
      ],
      "proyectosAnteriores": [
        "asistencias-security-lab",
        "security-baseline"
      ]
    },
    "ext-mensajes": {
      "descripcion": "MessageUcoLab 0.3.0 (kit del equipo de mensajeria, secretos en Doppler).",
      "memoriaMb": 3300,
      "directorio": "Complementos/CatalogoMensajes/messageucolab-local",
      "compose": [
        "compose.yaml",
        "@stack/secciones/ext-mensajes.yml"
      ],
      "envFiles": [],
      "doppler": {
        "proyecto": "messageucolab-local",
        "config": "dev"
      },
      "servicios": [
        "redis",
        "redis-init",
        "surrealdb",
        "surrealdb-init",
        "kong",
        "pulsar",
        "messageucolab"
      ],
      "salud": [
        "contenedor:ext-mensajes-app",
        "http:http://localhost:8000/actuator/health",
        "exec:ext-mensajes-pulsar|curl -sf -o /dev/null http://localhost:8080/admin/v2/brokers/health"
      ],
      "urls": [
        "API (Kong): http://localhost:8000",
        "Pulsar: pulsar://localhost:6800"
      ],
      "proyectosAnteriores": [
        "messageucolab"
      ],
      "requiere": [
        "ext-seguridad"
      ]
    },
    "ext-parametros": {
      "descripcion": "Catalogo de Parametros 0.1.17 y su microfrontend 0.1.16, con su broker Pulsar propio (kit del equipo; consulta M2M y eventos de cambios).",
      "memoriaMb": 1500,
      "directorio": "Complementos/CatalogoParametros/Catalogo-Parametros",
      "compose": [
        "docker-compose.yml",
        "@stack/secciones/ext-parametros.yml"
      ],
      "envFiles": [
        ".env"
      ],
      "servicios": [
        "redis",
        "surrealdb",
        "pulsar-parametros",
        "app",
        "frontend"
      ],
      "conflictos": [
        "asis-contingencia"
      ],
      "salud": [
        "contenedor:ext-parametros-app",
        "http:http://localhost:8081/actuator/health",
        "http:http://localhost:8082/admin/v2/brokers/health"
      ],
      "urls": [
        "API: http://localhost:8081/catalogo-parametros/api/v1",
        "Microfrontend: http://localhost:4201",
        "Pulsar del Catalogo: pulsar://localhost:6652 (desde asis-red: pulsar://pulsar-parametros:6650), administracion http://localhost:8082"
      ],
      "proyectosAnteriores": [
        "catalogo-parametros"
      ],
      "requiere": [
        "ext-seguridad"
      ]
    },
    "ext-notificaciones": {
      "descripcion": "Servicio de Notificaciones UCO 0.1.1 (componente propio en GestioAsistenciaBackend/servicios/notificaciones: correos con plantillas, cola en notificacionesdb del SQL Server del laboratorio).",
      "memoriaMb": 450,
      "directorio": "GestioAsistenciaBackend/servicios/notificaciones/notificaciones-local",
      "compose": [
        "compose.yaml"
      ],
      "envFiles": [
        ".env"
      ],
      "servicios": [
        "servicio"
      ],
      "requiere": [
        "asis-datos"
      ],
      "requiereImagenes": [
        "notificaciones-uco:0.1.1"
      ],
      "salud": [
        "contenedor:ext-notificaciones-servicio",
        "http:http://localhost:18090/actuator/health"
      ],
      "urls": [
        "API: http://localhost:18090/api/v1 (cabecera X-Api-Key)",
        "Entre contenedores: http://ext-notificaciones-servicio:8080"
      ],
      "proyectosAnteriores": [
        "notificaciones-local"
      ]
    },
    "asis-antivirus": {
      "descripcion": "ClamAV para las pruebas de soportes (adjuntos de reclamos y justificaciones).",
      "memoriaMb": 1300,
      "directorio": "GestioAsistenciaBackend/infra/files",
      "compose": [
        "compose.yaml",
        "@stack/secciones/asis-antivirus.yml"
      ],
      "envFiles": [
        ".env"
      ],
      "servicios": [
