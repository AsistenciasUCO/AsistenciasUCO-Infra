  "escenarios": {
    "minimo": {
      "secciones": [
        "asis-datos"
      ],
      "pruebas": "Gate de BD y scripts SQL sobre la BD del laboratorio."
    },
    "basico": {
      "secciones": [
        "asis-datos",
        "ext-seguridad",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "HU de los 5 roles (e2e_baseline.py, test_all_hus.ps1). Mensajes y parametros desde la BD."
    },
    "mensajes": {
      "secciones": [
        "asis-datos",
        "ext-seguridad",
        "ext-mensajes",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "Catalogo de mensajes, avisos por Pulsar -> BD, textos UI### de la SPA (int003_e2e)."
    },
    "parametros": {
      "secciones": [
        "asis-datos",
        "ext-seguridad",
        "ext-parametros",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "Catalogo de Parametros (test_catalogo_parametros.ps1) y microfrontend de administracion."
    },
    "completo": {
      "secciones": [
        "asis-datos",
        "ext-seguridad",
        "ext-mensajes",
        "ext-parametros",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "Flujos completos con los tres componentes externos (sin antivirus ni observabilidad)."
    },
    "soportes": {
      "secciones": [
        "asis-datos",
        "ext-seguridad",
        "asis-antivirus",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "Adjuntos de reclamos y justificaciones (MinIO + ClamAV)."
    },
    "cache": {
      "secciones": [
        "asis-datos",
        "ext-seguridad",
        "asis-cache",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "Cache Redis de consultas (portal, indicadores, catalogos), limite del QR y tiempo real entre replicas (REDIS-001)."
    },
    "observabilidad": {
      "secciones": [
        "asis-datos",
        "ext-seguridad",
        "asis-obs",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "Trazas, metricas y logs por correlationId en Grafana."
    },
    "contingencia": {
      "secciones": [
        "asis-datos",
        "asis-contingencia",
        "ext-notificaciones",
        "asis-app"
      ],
      "pruebas": "Arranque con el Keycloak propio (provider legacy) cuando falla el componente de Seguridad."
