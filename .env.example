# ==============================================================================
# 🏛️ ASISTENCIAS UCO - ARCHIVO CANÓNICO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Propósito: Única Fuente de Verdad (SSOT) de configuración y secretos para el
#            entorno local de desarrollo y orquestación de infraestructura.
#
# INSTRUCCIONES DE USO:
# 1. Copia este archivo como '.env' en la raíz de 'AsistenciasUCO-Infra/'
# 2. Reemplaza los valores 'change-me' o contraseñas por valores locales fuertes.
# 3. NUNCA comitees el archivo '.env' real a ningún repositorio Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUERTOS Y BINDING LOCAL (Host loopback 127.0.0.1 - Zero Proxy Forcing)
# ------------------------------------------------------------------------------
# Todos los puertos se enlazan explícitamente a 127.0.0.1 para acceso directo desde IDEs
HOST_BIND_IP=127.0.0.1

# Puerto SQL Server (1433)
SQL_HOST_PORT=1433

# Puertos Keycloak IAM (8081 para HTTP, 9001 para métricas/health de gestión)
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_MANAGEMENT_HOST_PORT=9001

# Puerto Backend API Spring Boot (8080)
BACKEND_HOST_PORT=8080

# Puerto Frontend SPA Angular (4200)
FRONTEND_HOST_PORT=4200

# Puertos Stack de Observabilidad
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Puertos Azurite (Emulación de Storage de Azure)
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS INSTITUCIONAL (Microsoft SQL Server 2022 Developer)
# ------------------------------------------------------------------------------
SQL_CONTAINER_NAME=sql_server_asistencias
MSSQL_PID=Developer
ACCEPT_EULA=Y
MSSQL_COLLATION=Modern_Spanish_CI_AS

# Límite de memoria para el contenedor (Preservación de RAM del host)
SQL_MEM_LIMIT=2g

# Base de datos institucional
SQL_DATABASE_NAME=gestionasistenciadb

# Credenciales de Administrador del Sistema (sa) - Solo para DDL/Deploy/Infra
MSSQL_SA_PASSWORD=CHANGE_ME_MSSQL_PASSWORD

# Credenciales de Aplicación (Principio de Mínimo Privilegio - Hardening)
# Este usuario solo tiene permisos EXECUTE en SPs y SELECT en Vistas (uv_*)
APP_DB_USERNAME=app_asistencias_user
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS DEDICADA PARA KEYCLOAK (PostgreSQL 17)
# ------------------------------------------------------------------------------
KC_DB_CONTAINER_NAME=keycloak_db_asistencias
KC_DB_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-postgres-keycloak
KC_DB_MEM_LIMIT=512m

# ------------------------------------------------------------------------------
# 4. GESTOR DE IDENTIDAD (Keycloak 26.0.0+ OIDC/OAuth2)
# ------------------------------------------------------------------------------
KEYCLOAK_CONTAINER_NAME=keycloak_asistencias
KEYCLOAK_VERSION=26.7.1
KEYCLOAK_MEM_LIMIT=1g

# Administrador de Bootstrap de Keycloak (Creación inicial del contenedor)
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-kcadmin

# URLs de conexión de Keycloak
KEYCLOAK_SERVER_URL=http://127.0.0.1:8081
KEYCLOAK_ISSUER_URI=http://127.0.0.1:8081/realms/asistencias-uco

# Contrato canónico del Realm institucional
KC_REALM=asistencias-uco
KC_API_CLIENT_ID=asistencias-api
KC_FRONTEND_CLIENT_ID=asistencias-uco-frontend
KC_BACKEND_ADMIN_CLIENT_ID=asistencias-backend-admin

# Client Secret confidencial para la API de Backend (asistencias-backend-admin)
# Debe coincidir con la variable KEYCLOAK_ADMIN_CLIENT_SECRET en Spring Boot
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-backend-admin-secret-32chars

# Políticas de contraseña (mínimo 12 caracteres por política institucional)
KC_PASSWORD_MIN_LENGTH=12

# ------------------------------------------------------------------------------
# 5. INTEGRACIÓN CON AZURE (App Configuration & Key Vault)
# ------------------------------------------------------------------------------
# Endpoint de Azure App Configuration (SSOT de mensajes y catálogos de negocio)
AZURE_APPCONFIG_ENDPOINT=https://appcs-asist-dev-29183.azconfig.io
AZURE_APPCONFIG_LABEL=es

# Endpoint de Azure Key Vault (SSOT de secretos en entornos cloud)
AZURE_KEYVAULT_ENDPOINT=https://kv-asist-dev-21245.vault.azure.net/

# Bandera de contingencia local (true = utiliza catálogos locales JSON ante desconexión)
AZURE_APPCONFIG_FALLBACK_LOCAL=true

# ------------------------------------------------------------------------------
# 6. ALMACENAMIENTO DE OBJETOS PRIVADO (MinIO S3 & ClamAV - LB-004B.2)
# ------------------------------------------------------------------------------
# Puerto S3 API de MinIO (9000) publicado exclusivamente en 127.0.0.1
MINIO_HOST_PORT=9000
MINIO_ENDPOINT=http://127.0.0.1:9000

# Consola Web (UI) desactivada por Hardening (cero superficie de ataque)
MINIO_BROWSER=off

# Identidad de Bootstrap/Administración de MinIO (Solo para aprovisionamiento inicial)
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

# Identidad de Aplicación (Principio de Mínimo Privilegio - Acceso estricto al bucket)
# Spring Boot consume EXCLUSIVAMENTE estas credenciales; NUNCA las credenciales root.
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=asistencias-soportes

# Puerto Demonio Antivirus ClamAV (3310 - Protocolo clamd INSTREAM)
CLAMAV_HOST_PORT=3310
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# 7. CONFIGURACIÓN DEL PERFIL DE ARRANQUE (Docker Compose Profiles)
# ------------------------------------------------------------------------------
# Perfil activo por defecto: 'core' (SQL Server + Keycloak)
# Perfiles disponibles: core | storage | observability | proxy | azure | full
COMPOSE_PROFILES=core
